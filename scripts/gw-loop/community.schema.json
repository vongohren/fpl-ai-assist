{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vongohren/fpl-ai-assist/scripts/gw-loop/community.schema.json",
  "title": "community",
  "description": "Community research per gameweek (doc id gw<N>) and the measured weight on the consensus (doc id weight). Written by scripts/gw-loop/community.mjs, proposal-page.mjs and calibrate.mjs; see scripts/gw-loop/README.md.",
  "oneOf": [{ "$ref": "#/$defs/gameweek" }, { "$ref": "#/$defs/weight" }],
  "$defs": {
    "num": { "type": ["number", "null"] },
    "gameweek": {
      "type": "object",
      "required": ["gw", "season", "generated_at", "players", "sources"],
      "properties": {
        "gw": { "type": "integer", "minimum": 1, "maximum": 38 },
        "season": { "type": "string", "pattern": "^\\d{4}-\\d{2}$" },
        "generated_at": { "type": "string" },
        "test": { "type": "boolean", "description": "true on a doc written to test the scripts; never read as data" },
        "top50": {
          "type": "object",
          "description": "Where top50_fielded / top50_captained come from: the first n entries of a classic league, their picks for the gameweek before this one (this one's are private until the deadline).",
          "properties": { "league": { "type": "integer" }, "event": { "type": "integer" }, "n": { "type": "integer" } }
        },
        "players": {
          "type": "object",
          "propertyNames": { "pattern": "^[0-9]+$" },
          "additionalProperties": { "$ref": "#/$defs/player" }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "kind"],
            "properties": {
              "source": { "type": "string" },
              "kind": { "enum": ["api", "projection", "stance"] },
              "url": { "type": "string" },
              "n": { "type": "integer", "description": "records taken from it" }
            }
          }
        }
      }
    },
    "player": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "web_name, for reading the doc; the key is the element id" },
        "team": { "type": "string" },
        "pos": { "enum": ["GK", "DEF", "MID", "FWD"] },
        "crowd": {
          "type": ["object", "null"],
          "properties": {
            "own_pct": { "type": "number" },
            "net_transfers_event": { "type": "integer" },
            "net_share": { "$ref": "#/$defs/num", "description": "net transfers this round over current owners" },
            "price_change_event": { "type": "number", "description": "£m since the last deadline" },
            "top50_fielded": { "type": ["integer", "null"] },
            "top50_captained": { "type": ["integer", "null"] }
          }
        },
        "consensus": {
          "type": ["object", "null"],
          "required": ["projections", "mean"],
          "properties": {
            "projections": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["source", "value"],
                "properties": { "source": { "type": "string" }, "url": { "type": "string" }, "value": { "type": "number" } }
              }
            },
            "mean": { "$ref": "#/$defs/num", "description": "expected points for this gameweek, mean over the sources" }
          }
        },
        "stances": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "stance"],
            "properties": {
              "source": { "type": "string" },
              "url": { "type": "string" },
              "date": { "type": "string" },
              "stance": { "enum": ["buy", "sell", "hold", "captain", "avoid"] },
              "quote": { "type": "string" }
            }
          }
        },
        "decision": {
          "type": ["object", "null"],
          "description": "Written by proposal-page.mjs: blended = (1 - w) x calc + w x consensus, calc alone when there is no consensus. calc / consensus / blended are this gameweek; the _six pair is the next six with only this gameweek blended.",
          "required": ["calc", "consensus", "w", "blended"],
          "properties": {
            "calc": { "type": "number" },
            "consensus": { "$ref": "#/$defs/num" },
            "w": { "type": "number", "minimum": 0, "maximum": 1 },
            "blended": { "type": "number" },
            "calc_six": { "type": "number" },
            "blended_six": { "type": "number" }
          }
        },
        "actual": { "type": ["integer", "null"], "description": "points scored this gameweek, filled by calibrate.mjs" }
      }
    },
    "weight": {
      "type": "object",
      "required": ["w", "method", "n_player_weeks", "err_calc", "err_consensus", "gws", "updated_at"],
      "properties": {
        "w": { "type": "number", "minimum": 0, "maximum": 1 },
        "method": { "enum": ["fixed", "inverse-variance"] },
        "n_player_weeks": { "type": "integer", "minimum": 0 },
        "err_calc": { "$ref": "#/$defs/num", "description": "mean absolute error of calc over the player-weeks with calc, consensus and actual" },
        "err_consensus": { "$ref": "#/$defs/num" },
        "gws": { "type": "array", "items": { "type": "integer" } },
        "updated_at": { "type": "string" },
        "min_gws": { "type": "integer", "description": "gameweeks of actuals before the method turns inverse-variance" },
        "test": { "type": "boolean" }
      }
    }
  }
}
